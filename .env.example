RATE_LIMIT_PUBLIC=60
RATE_LIMIT_ADMIN=120
PROVIDER_TIMEOUT_MS=10000
HAI_CONNECTOR_TOKEN=
HAI_CONNECTOR_PROJECT_KEY=016-Google-Agenda
HAI_CONNECTOR_MAX_ITEMS=100
