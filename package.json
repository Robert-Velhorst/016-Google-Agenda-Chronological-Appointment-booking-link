{
  "name": "chronological-booking",
  "version": "2.0.0",
  "private": true,
  "description": "Local-first Google Calendar booking service and appointment-choice sorter.",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "build": "vite build",
    "dev": "npm run build && node src/server.js",
    "start": "node src/server.js",
    "test": "node --test test/*.test.js && node test-content.js",
    "check": "node scripts/check.js",
    "doctor": "node scripts/doctor.js",
    "migrate": "node scripts/migrate.js",
    "backup": "node scripts/backup.js",
    "support:bundle": "node scripts/support-bundle.js",
    "hai:connector": "node integrations/hai/connector-server.js"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "dotenv": "^17.2.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^29.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^8.2.1"
  }
}
