{
  "name": "chronological-booking",
  "version": "2.0.0",
  "private": true,
  "packageManager": "npm@12.2.1",
  "description": "Local-first Google Calendar booking service and appointment-choice sorter.",
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "scripts": {
    "build": "vite build",
    "dev": "npm run build && node src/server.js",
    "start": "node src/server.js",
    "test": "node --test test/*.test.js && node test-content.js",
    "check": "node scripts/check.js",
    "doctor": "node scripts/doctor.js",
    "migrate": "node scripts/migrate.js",
    "backup": "node scripts/backup.js",
    "support:bundle": "node scripts/support-bundle.js",
    "hai:connector": "node integrations/hai/connector-server.js",
    "build:sqlite": "node scripts/build-stable-sqlite.mjs --require-upgrade-baseline",
    "verify:runtime": "node scripts/verify-stable-runtime.js"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "dotenv": "18.0.9",
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5",
    "node-gyp": "13.1.0"
  },
  "license": "AGPL-3.0-only"
}
